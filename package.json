{
  "name": "pintapost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Editor enriquecido para publicaciones de LinkedIn",
  "scripts": {
    "build:css": "tailwindcss -i ./public/static/css/styles.css -o ./public/static/css/tailwind.css --minify",
    "build:fonts": "node scripts/copy-fonts.mjs",
    "watch:css": "tailwindcss -i ./public/static/css/styles.css -o ./public/static/css/tailwind.css --watch",
    "build": "pnpm run build:fonts && pnpm run build:css",
    "dev": "pnpm run watch:css",
    "preview": "wrangler dev",
    "test": "node --test \"tests/**/*.test.js\"",
    "clean": "node -e \"import('node:fs').then(fs=>{fs.rmSync('public/static/css/tailwind.css',{force:true});fs.rmSync('public/static/assets/fonts',{force:true,recursive:true})})\""
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/forms": "^0.5.10",
    "linkedom": "^0.18.13",
    "tailwindcss": "^3.4.17",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.0.0"
}

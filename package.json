{
  "name": "pintapost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Editor enriquecido para publicaciones de LinkedIn",
  "scripts": {
    "build:css": "tailwindcss -i ./public/static/css/styles.css -o ./public/static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./public/static/css/styles.css -o ./public/static/css/tailwind.css --watch",
    "build": "pnpm run build:css",
    "dev": "pnpm run watch:css",
    "preview": "wrangler dev",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('public/static/css/tailwind.css',{force:true}))\""
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "tailwindcss": "^3.4.17",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.0.0"
}
